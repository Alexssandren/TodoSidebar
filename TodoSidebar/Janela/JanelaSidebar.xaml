<Window x:Class="TodoSidebar.Janela.JanelaSidebar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tarefas"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Superficie}"
        Foreground="{DynamicResource Texto}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Janela_PreviewKeyDown"
        MouseEnter="Janela_MouseEnter"
        MouseLeave="Janela_MouseLeave"
        PreviewMouseLeftButtonUp="Janela_MouseUp">
    <Grid>
        <Border x:Name="AlcaVisual" Background="{DynamicResource Borda}" Width="4" HorizontalAlignment="Center" CornerRadius="2"/>
        <DockPanel x:Name="PainelVisual" Visibility="Collapsed" Margin="16,12">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{DynamicResource BotaoCabecalho}" Margin="0"
                        Click="Fechar_Click" AutomationProperties.Name="Fechar" ToolTip="Fechar">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE8BB;"
                               IsHitTestVisible="False"/>
                </Button>
                <Button x:Name="BotaoRecolher" DockPanel.Dock="Right" Style="{DynamicResource BotaoCabecalho}"
                        Margin="0,0,8,0" Click="Recolher_Click"
                        AutomationProperties.Name="Recolher" ToolTip="Recolher">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE76C;"
                               IsHitTestVisible="False"/>
                </Button>
                <TextBlock Text="Tarefas" VerticalAlignment="Center" Style="{DynamicResource Titulo}"/>
            </DockPanel>
            <TextBlock x:Name="AvisoAtalho" DockPanel.Dock="Top" TextWrapping="Wrap"
                       Style="{DynamicResource Secundario}" Margin="0,0,0,12"/>
            <ContentControl x:Name="Conteudo"/>
        </DockPanel>
    </Grid>
</Window>
