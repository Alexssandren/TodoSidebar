<Window x:Class="TodoSidebar.Janela.JanelaSidebar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tarefas"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="#121212"
        Foreground="#E8E8E8"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Janela_PreviewKeyDown"
        MouseEnter="Janela_MouseEnter"
        MouseLeave="Janela_MouseLeave"
        PreviewMouseLeftButtonUp="Janela_MouseUp">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="AlcaVisual" Background="#3A3A3A" Width="4" HorizontalAlignment="Center" CornerRadius="2"/>
        <DockPanel x:Name="PainelVisual" Visibility="Collapsed" Margin="16,12">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="Fechar" Margin="0" Click="Fechar_Click" AutomationProperties.Name="Fechar"/>
                <Button x:Name="BotaoRecolher" DockPanel.Dock="Right" Content="Recolher" Click="Recolher_Click" AutomationProperties.Name="Recolher"/>
                <TextBlock Text="Tarefas" VerticalAlignment="Center" FontSize="14"/>
            </DockPanel>
            <TextBlock x:Name="AvisoAtalho" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#9A9A9A" Margin="0,0,0,12"/>
            <ContentControl x:Name="Conteudo"/>
        </DockPanel>
    </Grid>
</Window>
