<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Superficie" Color="#1E1E22"/>
    <SolidColorBrush x:Key="SuperficieCampo" Color="#2A2A30"/>
    <SolidColorBrush x:Key="SuperficieHover" Color="#34343C"/>
    <SolidColorBrush x:Key="SuperficiePressed" Color="#222228"/>
    <SolidColorBrush x:Key="SuperficieConfirmacao" Color="#322E28"/>
    <SolidColorBrush x:Key="Borda" Color="#3A3A42"/>
    <SolidColorBrush x:Key="BordaFoco" Color="#9B8CFF"/>
    <SolidColorBrush x:Key="Texto" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="TextoSecundario" Color="#B4B4BE"/>
    <SolidColorBrush x:Key="TextoConcluido" Color="#8E8E98"/>
    <SolidColorBrush x:Key="Aviso" Color="#E2B657"/>
    <SolidColorBrush x:Key="Perigo" Color="#E08B84"/>
    <SolidColorBrush x:Key="Arraste" Color="#9B8CFF"/>
    <CornerRadius x:Key="Raio">6</CornerRadius>

    <!-- ponytail: template proprio; o Aero2 ignora Background/BorderBrush no hover, pressed e foco -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SuperficieCampo}"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Raio}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SuperficieHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SuperficiePressed}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BordaFoco}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoCabecalho" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSecundario}"/>
    </Style>

    <!-- ponytail: template proprio; o Aero2 ignora BorderBrush e pinta foco com TextBox.Focus.Border do sistema -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SuperficieCampo}"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Texto}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource BordaFoco}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Raio}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TextoSecundario}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BordaFoco}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ponytail: template proprio; a caixa nativa fica clara no tema do Windows -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Border x:Name="caixa"
                                Width="16" Height="16"
                                Margin="0,0,8,0"
                                CornerRadius="3"
                                BorderThickness="1"
                                BorderBrush="{StaticResource Borda}"
                                Background="Transparent"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left">
                            <Path x:Name="marca"
                                  Data="M2,8 L6,12 L14,3"
                                  Stroke="{StaticResource Superficie}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="caixa" Property="Background" Value="{StaticResource BordaFoco}"/>
                            <Setter TargetName="caixa" Property="BorderBrush" Value="{StaticResource BordaFoco}"/>
                            <Setter TargetName="marca" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="caixa" Property="BorderBrush" Value="{StaticResource TextoSecundario}"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="caixa" Property="BorderBrush" Value="{StaticResource BordaFoco}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Titulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
    </Style>

    <Style x:Key="Secao" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSecundario}"/>
        <Setter Property="Margin" Value="0,12,0,6"/>
    </Style>

    <Style x:Key="Secundario" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSecundario}"/>
    </Style>
</ResourceDictionary>
