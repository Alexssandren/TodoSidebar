<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>TodoSidebar-1.0.0</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputPath>$(MSBuildThisFileDirectory)..\dist\instalador\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(Configuration)\</IntermediateOutputPath>
    <PublishDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\dist\app\'))</PublishDir>
    <DefineConstants>PublishDir=$(PublishDir)</DefineConstants>
    <SuppressIces>ICE91;ICE64;ICE38;ICE61</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <BindInputPaths Include="$(PublishDir)" BindName="PublishDir" />
  </ItemGroup>

  <Target Name="PublicarApp" BeforeTargets="BeforeBuild">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\TodoSidebar\TodoSidebar.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(PublishDir);DebugType=None;DebugSymbols=false" />
  </Target>
</Project>
