<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="TodoSidebar"
           Manufacturer="TodoSidebar"
           Version="1.0.0"
           Language="1046"
           UpgradeCode="8f3a2b1c-9d47-4e10-a6f8-7b21c0d4e5a6"
           Scope="perUser">
    <SummaryInformation Description="Lista pessoal de tarefas em barra lateral" />
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="Ja existe uma versao mais recente do TodoSidebar." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <util:CloseApplication Id="FecharTodoSidebar"
                           Target="TodoSidebar.exe"
                           CloseMessage="yes"
                           RebootPrompt="no"
                           TerminateProcess="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="TodoSidebar" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="TodoSidebar" />
    </StandardDirectory>

    <Feature Id="Principal" Title="TodoSidebar" Level="1">
      <ComponentGroupRef Id="ArquivosApp" />
      <ComponentRef Id="AtalhoMenu" />
    </Feature>

    <Component Id="AtalhoMenu" Directory="AppMenuFolder" Guid="b2c4d6e8-1a30-4f52-9c7e-88a1b3d4e5f6">
      <Shortcut Id="AtalhoIniciar"
                Name="TodoSidebar"
                Target="[INSTALLFOLDER]TodoSidebar.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="AppMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\TodoSidebar"
                     Name="Instalado"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Nao grava Run: a opcao continua no aplicativo. Remove so na desinstalacao completa. -->
    <CustomAction Id="LimparInicioAuto"
                  Directory="System64Folder"
                  ExeCommand="reg.exe delete HKCU\Software\Microsoft\Windows\CurrentVersion\Run /v TodoSidebar /f"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="LimparInicioAuto" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <ComponentGroup Id="ArquivosApp" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)**">
        <Exclude Files="$(PublishDir)**\*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>
</Wix>
